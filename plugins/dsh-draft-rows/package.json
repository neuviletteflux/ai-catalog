{
  "name": "dsh-draft-rows",
  "version": "0.2.0",
  "description": "Draft sessions for DeepSeek Harness: one New Session row per workspace, typed drafts kept as their own rows, and draft rows sorted above pinned sessions.",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "plugin.yaml",
    "locale",
    "assets"
  ],
  "scripts": {
    "test": "node --test tests/logic.test.mjs tests/apply.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "drafts",
    "new-session",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuviletteflux/ai-catalog.git",
    "directory": "plugins/dsh-draft-rows"
  },
  "homepage": "https://github.com/neuviletteflux/ai-catalog/tree/main/plugins/dsh-draft-rows",
  "bugs": "https://github.com/neuviletteflux/ai-catalog/issues",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "license": "MIT"
}
